# Copy to backend/.env (or export) and run uvicorn/pytest from backend/. Never commit .env.
# Names match backend/app/settings.py (SAHAY_ prefix).
SAHAY_DEV=1
# Required when SAHAY_DEV is off:
SAHAY_JWT_SECRET=
SAHAY_DATABASE_URL=sqlite:///./sahay.db
SAHAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server keys (base64, 32 bytes). In dev they are generated into key files if unset.
SAHAY_SERVER_X25519_SECRET_KEY=
SAHAY_SERVER_ED25519_SECRET_KEY=

# Speech-to-text (B-05). mock = no audio model (tests, offline demo). live = providers below, tried left to right.
# A report is never lost if STT fails: the pipeline continues from the quick-tap category.
SAHAY_STT_MODE=mock
# gemini:<model> uses LLM_API_KEY_GEMINI (best on Malayalam, see docs/stt-eval.md; free-tier keys may let Google train on the audio).
# groq:<model> uses LLM_API_KEY (LLM_PROVIDER=groq). cf:<model> = Cloudflare Workers AI: CLOUDFLARE_ACCOUNT_ID plus
# a token in CLOUDFLARE_API_TOKEN or STT_API_KEY.
SAHAY_STT_PROVIDERS=gemini:gemini-2.5-flash,groq:whisper-large-v3
SAHAY_STT_TIMEOUT_S=20
STT_API_KEY=
SAHAY_STT_PROMPT=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Agents (B-06). mock = deterministic rules, no network (tests and offline demo).
# live = call the provider below; any failure falls back to rules, so a report is never lost.
SAHAY_LLM_MODE=mock
LLM_PROVIDER=groq
LLM_API_KEY=
# Second provider, tried when the primary fails or is rate-limited (before the rules fallback).
# Free-tier Gemini may use prompts to improve Google products: use a paid key or keep real data off it.
LLM_FALLBACK_PROVIDER=
LLM_API_KEY_GEMINI=
LLM_GEMINI_MODEL=gemini-flash-latest
LLM_MODEL=openai/gpt-oss-120b
# Optional: another OpenAI-compatible endpoint (leave empty for the provider default)
LLM_BASE_URL=
LLM_TIMEOUT_S=15
# Reasoning models only (gpt-oss). "low" cuts tokens and latency. Empty = do not send.
LLM_REASONING_EFFORT=low

# Hazard-context web search for triage (Firecrawl). mock = canned tips, live = Firecrawl.
# The query contains only hazard words like "gas" or "chemical", never report text or PII.
SAHAY_SEARCH_MODE=mock
SAHAY_WEB_SEARCH_KEY=
SAHAY_WEB_SEARCH_KEY=your-web-search-key-here
