# Copy to backend/.env (or export). Never commit .env.
# Names match backend/app/settings.py (SAHAY_ prefix).
SAHAY_DEV=1
# Required when SAHAY_DEV is off:
SAHAY_JWT_SECRET=
SAHAY_DATABASE_URL=sqlite:///./sahay.db
SAHAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server keys (base64, 32 bytes). In dev they are generated into key files if unset.
SAHAY_SERVER_X25519_SECRET_KEY=
SAHAY_SERVER_ED25519_SECRET_KEY=

# Speech-to-text (B-05). Decision: primary + ordered fallbacks, all via Cloudflare Workers AI.
# Order is tried left to right; a provider that errors or times out falls through to the next.
SAHAY_STT_PROVIDERS=whisper-large-v3-turbo,nova-3,gpt-4o-transcribe
SAHAY_STT_TIMEOUT_S=20
# Set to 'mock' for tests and the offline demo (returns the sample transcript, no network).
SAHAY_STT_MODE=live
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Models on Workers AI: @cf/openai/whisper-large-v3-turbo, @cf/deepgram/nova-3
# gpt-4o-transcribe is an OpenAI model: reached through Cloudflare AI Gateway (verify in B-05).
CLOUDFLARE_AI_GATEWAY_URL=
OPENAI_API_KEY=
# Optional direct Deepgram key if nova-3 is called outside Workers AI.
DEEPGRAM_API_KEY=

# Agents (B-06). mock = deterministic rules, no network (tests and offline demo).
SAHAY_LLM_MODE=mock
LLM_PROVIDER=
LLM_API_KEY=

# Web
VITE_API_BASE=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/v1
